{
    "name": "black-book-browser",
    "private": true,
    "version": "4.6.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "prepare": "svelte-kit sync",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint . && reuse lint",
        "format": "prettier --write .",
        "tauri": "tauri",
        "update-patrons": "node scripts/update-patrons.js",
        "actions": "act --artifact-server-path ./artifacts --env CACHE_BIN=false",
        "version": "node scripts/applyVersionToTauri.js"
    },
    "dependencies": {
        "@humanspeak/svelte-virtual-list": "^0.5.14",
        "@ionic/core": "^9.0.5",
        "@tauri-apps/api": "^2.12.0",
        "@tauri-apps/plugin-dialog": "^2.8.0",
        "@tauri-apps/plugin-fs": "^2.6.0",
        "@tauri-apps/plugin-opener": "^2.7.0",
        "fuzzysort": "^4.0.2",
        "highlight.js": "^11.12.0",
        "ionicons": "^8.1.0",
        "picomatch": "^4.0.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tauri-apps/cli": "^2.12.0",
        "@tsconfig/svelte": "^5.0.8",
        "@types/node": "^26.6.3",
        "@types/picomatch": "^4.0.3",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.12.0",
        "prettier": "^3.9.9",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "svelte-preprocess": "^6.0.5",
        "svelte-preprocess-import-assets": "^1.1.0",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.1"
    }
}
